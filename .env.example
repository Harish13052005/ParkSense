SECRET_KEY=replace-with-a-long-random-session-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-jwt-secret
PARKING_TIMEZONE=Asia/Kolkata

# MySQL is the default database. Set the password locally; never commit it.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=parksense_db
MYSQL_USER=parksense_user
MYSQL_PASSWORD=replace-with-your-database-password

# For intentional local SQLite development, set both:
# DATABASE_URL=sqlite:///parksense.db
# PARKSENSE_ALLOW_SQLITE=1
