DATABASE_URL=sqlite:///parksense.db
SECRET_KEY=replace-with-a-long-random-session-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-jwt-secret
PARKING_TIMEZONE=Asia/Kolkata

